# The Gardening Assistant (TGA) - Environment Variables Template
# ElevenLabs API Key (Best Use of ElevenLabs - optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# SerpApi API Key (Best Use of SerpApi - optional)
SERPAPI_API_KEY=your_serpapi_api_key_here

# Sentry DSN (Best Use of Sentry Agent Tracing - optional)
SENTRY_DSN=your_sentry_dsn_here

# Gemma AI Mode (local via Ollama or groq)
GEMMA_MODE=local
GROQ_API_KEY=your_groq_api_key_here_for_cloud_gemma
